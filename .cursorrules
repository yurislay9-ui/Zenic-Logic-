## PATRON BASEAGENT — CADA AGENTE NUEVO DEBE SEGUIR ESTE PATRON

```python
from src.core.agents_v2.resilience.base_agent import BaseAgent
from src.core.agents_v2.schemas.types import AgentResult  # o tipo especifico

class MiNuevoAgente(BaseAgent[MiResultado]):
    """Axx NombreAgente — UNA sola responsabilidad."""

    def __init__(self, **kwargs):
        super().__init__(name="Axx_NombreAgente", **kwargs)

    def execute(self, input_data: Any) -> MiResultado:
        """Logica determinista principal. NUNCA llama al LLM."""
        # ... logica pura ...
        return MiResultado(...)

    def fallback(self, input_data: Any) -> MiResultado:
        """Fallback determinista. SIEMPRE funciona. NUNCA falla."""
        return MiResultado(...)  # valores seguros/conservadores
```

