# ============================================================
#  TITAN OMNISCALE X v16 - Production Environment
#  Phase 3: VPS Deploy
#
#  INSTRUCTIONS:
#  1. Copy this file as .env: cp .env.production .env
#  2. Generate secure secrets (see below)
#  3. Set your domain name
#  4. NEVER commit .env to Git
#
#  Generate secrets:
#    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

# ── Environment ─────────────────────────────────────────────
TITAN_ENV=production
TITAN_SERVER_MODE=fastapi
TITAN_AUTH_ENABLED=true

# ── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://titan:CHANGE_ME_DB_PASSWORD@db:5432/titan_db
DATABASE_URL_SYNC=postgresql+psycopg2://titan:CHANGE_ME_DB_PASSWORD@db:5432/titan_db
POSTGRES_DB=titan_db
POSTGRES_USER=titan
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_SECURE_DB_PASSWORD

# ── Auth / JWT ─────────────────────────────────────────────
TITAN_AUTH_SECRET=CHANGE_ME_GENERATE_A_SECURE_JWT_SECRET

# ── Domain & SSL ───────────────────────────────────────────
TITAN_DOMAIN=api.yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# ── Resources ──────────────────────────────────────────────
TITAN_RAM_LIMIT_MB=2048
TITAN_WORKERS=4

# ── GitHub (optional) ──────────────────────────────────────
GITHUB_TOKEN=

# ── Backup ─────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
JSON_LOGS=true
